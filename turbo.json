{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env*"],
  "globalEnv": ["NODE_ENV", "MONGO_URI", "SERVER_PORT", "API_BASE_URL"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "server#build": {
      "dependsOn": ["@qubbi/sdk-builder#build"],
      "outputs": ["dist/**"]
    },

    "server#sdk-builder": {
      "dependsOn": ["server#build"],
      "outputs": ["../../packages/sdk/src/generated.ts"]
    },

    "@qubbi/sdk#build": {
      "dependsOn": ["server#sdk-builder"],
      "outputs": ["dist/**"]
    },

    "lint": {}
  }
}
